#!/bin/sh
# Clean installs coordinate APs on LAN using upstream steering policies.
# Preserve the user's service choice across config-preserving upgrades.
[ ! -e /tmp/mx4300-config-restored ] || exit 0
uci set usteer.@usteer[0].enabled=1
uci set usteer.@usteer[0].network=lan
uci commit usteer
/etc/init.d/usteer enable
exit 0
