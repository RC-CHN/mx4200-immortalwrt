# Both provisioning layouts get distinct images. Confirm the device before flashing.
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_linksys_homewrk=y
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_linksys_mx4300=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_DEVEL=y
CONFIG_IMAGEOPT=y
CONFIG_CCACHE=y
CONFIG_FEED_video=n

# Full wpad includes SAE, 802.11s and fast-transition support.
CONFIG_PACKAGE_MAC80211_MESH=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_wpad-basic-openssl=n
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_usteer=y
CONFIG_PACKAGE_luci-app-usteer=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_kmod-tun=y

# USB controllers are also supplied by the target's defaults.
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-dwc3-qcom=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_usbutils=y

# Measure the complete client -> AP -> mesh -> gateway path on hardware.
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_conntrack=y

# Kernel modules must come from this build, not an unrelated snapshot image.
CONFIG_PACKAGE_luci-app-attendedsysupgrade=n
CONFIG_PACKAGE_luci-app-advanced-reboot=n
